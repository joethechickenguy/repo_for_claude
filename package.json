{
  "name": "bootstrap",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run content -- --quiet",
    "dev": "vite",
    "build": "npm run content && tsc --noEmit && vite build",
    "content": "node scripts/build-content.mjs",
    "validate": "python3 tools/validate_tree.py --check",
    "pretest": "npm run content -- --quiet",
    "test": "vitest run",
    "pretypecheck": "npm run content -- --quiet",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.4",
    "happy-dom": "^20.14.5",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
